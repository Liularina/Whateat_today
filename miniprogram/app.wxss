/**
 * 全局样式
 * 风格约束：家庭 / 温暖 / 干净 / 简单 / 有食欲（浅色背景、大卡片、圆角、少文字）
 * 色彩令牌同时用于覆盖 TDesign 主题变量，保证自研组件与 TDesign 组件视觉一致。
 */
page {
  /* ---- TDesign 主题覆盖（暖橙色系） ---- */
  --td-brand-color: #ff7a45;
  --td-brand-color-light: #fff1e9;
  --td-brand-color-focus: #ffe0cf;
  --td-brand-color-active: #d95f2f;
  --td-success-color: #34b262;
  --td-warning-color: #ffa940;
  --td-error-color: #e34d59;
  --td-text-color-primary: #2f2620;
  --td-text-color-secondary: #7b6a5c;
  --td-text-color-placeholder: #b3a79b;
  --td-bg-color-page: #fbf7f2;
  --td-bg-color-container: #ffffff;
  --td-radius-default: 16rpx;
  --td-radius-large: 24rpx;

  /* ---- 自有令牌，供自研组件使用 ---- */
  --wte-bg: #fbf7f2;
  --wte-card: #ffffff;
  --wte-brand: #ff7a45;
  --wte-brand-deep: #d95f2f;
  --wte-text: #2f2620;
  --wte-text-weak: #7b6a5c;
  --wte-text-faint: #a99a8b;
  --wte-line: #f0e7de;
  --wte-fill: #faf6f0;
  /* 破坏性操作（删除）与「需采购」一类需要注意的提示统一用橙色 */
  --wte-warn: #e8850c;
  --wte-warn-bg: #fff4e6;
  --wte-warn-line: #ffddb0;

  /* ---- 字号层级：全站统一，避免各页面各写一套大小 ---- */
  --wte-fs-caption: 22rpx;  /* 角标、辅助说明 */
  --wte-fs-sm: 24rpx;       /* 次要信息 */
  --wte-fs-base: 28rpx;     /* 正文 */
  --wte-fs-md: 30rpx;       /* 小标题、强调正文 */
  --wte-fs-lg: 34rpx;       /* 卡片标题 */
  --wte-fs-xl: 40rpx;       /* 页面主标题 */
  --wte-fs-display: 44rpx;  /* 首屏大标题、关键数字 */

  background-color: var(--wte-bg);
  color: var(--wte-text);
  font-size: var(--wte-fs-base);
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Helvetica, sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ---------- 布局 ---------- */
.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.page--with-footer {
  padding-bottom: 180rpx;
}

.section {
  margin-top: 40rpx;
}

.section__title {
  font-size: var(--wte-fs-md);
  font-weight: 600;
  color: var(--wte-text);
  margin-bottom: 20rpx;
}

/* ---------- 头部 ---------- */
.page-header {
  padding: 16rpx 0 8rpx;
}

.page-header__title {
  font-size: var(--wte-fs-xl);
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.3;
}

.page-header__subtitle {
  margin-top: 10rpx;
  font-size: var(--wte-fs-sm);
  color: var(--wte-text-weak);
  line-height: 1.5;
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--wte-card);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 6rpx 24rpx rgba(180, 140, 105, 0.07);
}

/* 卡片内统一标题 */
.card__title {
  font-size: var(--wte-fs-sm);
  color: var(--wte-text-weak);
  letter-spacing: 0.5rpx;
}

.card__desc {
  font-size: var(--wte-fs-sm);
  color: var(--wte-text-weak);
  line-height: 1.6;
}

.card + .card {
  margin-top: 24rpx;
}

.card--flat {
  box-shadow: none;
  border: 2rpx solid var(--wte-line);
}

/* ---------- 按钮 ---------- */
.wte-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 999rpx;
  font-size: var(--wte-fs-md);
  font-weight: 600;
  letter-spacing: 0.5rpx;
  transition: opacity 0.15s ease;
}

/* 小号按钮：卡片内的次级操作（各页面共用，避免重复定义） */
.wte-btn--sm {
  display: inline-flex;
  height: auto;
  min-height: 56rpx;
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  font-size: var(--wte-fs-sm);
  font-weight: 500;
}

.wte-btn--primary {
  background: linear-gradient(135deg, #ff9a6b, #ff7a45);
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(255, 122, 69, 0.28);
}

.wte-btn--ghost {
  background: #ffffff;
  color: var(--wte-brand);
  border: 2rpx solid var(--wte-brand);
}

.wte-btn--plain {
  background: #fff1e9;
  color: #d95f2f;
}

/* 破坏性操作（删除）：橙色标注，与主操作、普通操作都区分开 */
.wte-btn--danger {
  background: var(--wte-warn-bg);
  border: 2rpx solid var(--wte-warn-line);
  color: var(--wte-warn);
}

.wte-btn--block {
  width: 100%;
}

.wte-btn:active,
.wte-btn--hover {
  opacity: 0.82;
}

.wte-btn[disabled] {
  opacity: 0.45;
}

/* 首页等页面底部固定操作区 */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(251, 247, 242, 0.96);
  border-top: 2rpx solid var(--wte-line);
  box-sizing: border-box;
}

/* ---------- 文本工具类 ---------- */
.text-weak {
  color: var(--wte-text-weak);
}

.text-brand {
  color: var(--wte-brand);
}

.text-sm {
  font-size: 24rpx;
}

.text-lg {
  font-size: 36rpx;
}

.text-bold {
  font-weight: 600;
}

/* ---------- 列表行 ---------- */
.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--wte-line);
}

.list-row:last-child {
  border-bottom: none;
}

/* ---------- 标签 ---------- */
.chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  background: #fff1e9;
  color: #d95f2f;
}

.chip--active {
  background: var(--wte-brand);
  color: #ffffff;
}

.chip--muted {
  background: #f4efe9;
  color: var(--wte-text-weak);
}
