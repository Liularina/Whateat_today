/* 菜单详情（Phase 11 → A3 营养展示） */

.meta-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 4rpx 24rpx;
  font-size: var(--wte-fs-sm);
  color: var(--wte-text-weak);
}

.meta-hint {
  color: #c07a52;
}

/* 营养汇总 */
.nutrition-summary {
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #fff5eb, #fff0e0);
  border: 1rpx solid #ffe0c0;
}

.nutrition-summary__head {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.nutrition-summary__label {
  font-size: 26rpx;
  color: #9a8c7d;
}

.nutrition-summary__kcal {
  font-size: 36rpx;
  font-weight: 700;
  color: #ff7a45;
}

.nutrition-summary__sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #c2947a;
}

.nutrition-summary__warn {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #f5a623;
  line-height: 1.5;
}

.nutrition-summary__note {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #d4c5b5;
}

.nutrition-summary__macro {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b5a47;
}

/* 菜品列表 */
.dish-list {
  margin-top: 4rpx;
}

.dish-card {
  padding: 26rpx;
  background: #faf6f0;
  border-radius: 16rpx;
}

.dish-card + .dish-card {
  margin-top: 16rpx;
}

.dish-card--hover {
  background: #fff3e8;
}

.dish-card__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--wte-text);
}

.dish-card__lock {
  margin-left: 8rpx;
}

.dish-card__meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--wte-text-weak);
  flex-wrap: wrap;
}

.dish-card__nutrition {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 8rpx;
}

.dish-card__kcal {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff7a45;
}

.dish-card__nutrition-text {
  font-size: 26rpx;
  color: #5c4a3a;
  line-height: 1.6;
}

.dish-card__nutrition-row {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #d4c5b5;
}

.dish-card__partial-hint {
  font-size: 22rpx;
  color: #f5a623;
}

.dish-card__desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--wte-text-weak);
  line-height: 1.5;
}

.dish-card__ing {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--wte-text-weak);
  line-height: 1.5;
}

/* 采购清单入口（Phase E1） */
.action-bar {
  margin-bottom: 24rpx;
}

.action-bar__btn {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 36rpx;
  background: linear-gradient(135deg, #fff5eb, #fff0e0);
  border: 2rpx solid #ffe0c0;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #ff7a45;
  transition: opacity 0.15s;
}

.action-bar__btn--hover {
  opacity: 0.75;
}
/* Phase 1：掌勺人确认标记 */
.chip--cook {
  background: #eef7ee;
  color: #3d8b40;
}

/* ===== 阶段二：完成状态 / 成长 / 评价 ===== */
.meal-status {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(180, 150, 120, 0.06);
}

.meal-status__hint {
  margin-bottom: 18rpx;
  font-size: 26rpx;
  color: var(--wte-text-weak);
  line-height: 1.6;
}

.meal-status__done {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.meal-status__icon {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #eef7ee;
  color: #3d8b40;
  font-size: 28rpx;
  font-weight: 700;
}

.meal-status__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #3d8b40;
}

.meal-status__sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #a08a76;
}

.growth-card {
  margin-bottom: 24rpx;
  padding: 26rpx;
  background: linear-gradient(135deg, #fff8f0, #fff2e4);
  border: 2rpx solid #ffe6cd;
  border-radius: 20rpx;
}

.growth-card__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.growth-card__level {
  font-size: 30rpx;
  font-weight: 700;
  color: #b9762f;
}

.growth-card__points {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff7a45;
}

.growth-card__owner {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #a08a76;
}

.growth-card__bar {
  margin-top: 16rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #ffe6cd;
  overflow: hidden;
}

.growth-card__bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ffb066, #ff7a45);
}

.growth-card__next {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #a08a76;
}

.growth-card__last {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #c2947a;
}

.review {
  margin-bottom: 32rpx;
  padding: 26rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(180, 150, 120, 0.06);
}

.review__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.review__title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--wte-text);
}

.review__overall {
  font-size: 26rpx;
  font-weight: 600;
  color: #ff7a45;
}

.review__progress {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #a08a76;
  line-height: 1.6;
}

.review__error {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #d9534f;
}

.review__loading {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #c2947a;
}

.review-dish {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #f2e7dc;
}

.review-dish__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.review-dish__name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--wte-text);
}

.review-dish__stat {
  font-size: 22rpx;
  color: #b0a094;
}

.review-dish__avg {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #b9762f;
}

.review-dish__stars {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
}

.review-dish__star {
  font-size: 44rpx;
  line-height: 1;
  color: #e6dcd2;
}

.review-dish__star--on {
  color: #ffb020;
}

.review-dish__mine {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #b9762f;
}

.review-dish__mine--none {
  color: #c9bcb0;
}

.review-dish__comment {
  margin-top: 12rpx;
  padding: 14rpx 18rpx;
  background: #fdf9f5;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--wte-text);
}

.review-dish__comments {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #a08a76;
  line-height: 1.5;
}

.review__submit {
  margin-top: 24rpx;
}

.review__note {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #c9bcb0;
  line-height: 1.6;
}
