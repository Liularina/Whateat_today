<view class="page">
  <loading-state wx:if="{{loading}}" text="正在加载菜单..." />

  <error-state
    wx:elif="{{error}}"
    title="菜单加载失败"
    description="{{error}}"
    retryText="重试"
    bind:retry="onRetry"
  />

  <block wx:else>
    <view class="page-header">
      <view class="page-header__title">{{mealTypeLabel}} · {{servings}} 人份</view>
      <view class="page-header__subtitle" wx:if="{{dateLabel}}">{{dateLabel}}</view>
    </view>

    <view class="meta-row">
      <view class="chip chip--muted">{{statusLabel}}</view>
      <text>{{dishes.length}} 道菜</text>
      <text class="meta-hint">（点击菜品可查看做法）</text>
    </view>

    <empty-state wx:if="{{dishes.length === 0}}" emoji="🍱" title="这份菜单没有菜品" />

    <view class="dish-list" wx:else>
      <view
        class="dish-card"
        wx:for="{{dishes}}"
        wx:key="recipeId"
        data-id="{{item.recipeId}}"
        data-name="{{item.name}}"
        bindtap="onOpenRecipe"
        hover-class="dish-card--hover"
      >
        <view class="dish-card__top">
          <view class="dish-card__name">
            {{item.name}}
            <text wx:if="{{item.locked}}" class="dish-card__lock">🔒</text>
          </view>
          <view class="dish-card__meta">
            <view class="chip chip--muted" wx:if="{{item.category}}">{{item.category}}</view>
            <text wx:if="{{item.difficultyLabel}}">{{item.difficultyLabel}}</text>
            <text wx:if="{{item.cookTime}}">{{item.cookTime}}</text>
          </view>
        </view>
        <view class="dish-card__desc" wx:if="{{item.description}}">{{item.description}}</view>
        <view class="dish-card__ing" wx:if="{{item.ingredientsText}}">食材：{{item.ingredientsText}}</view>
      </view>
    </view>
  </block>
</view>