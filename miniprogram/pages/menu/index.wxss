.tabs {
  display: flex;
  padding: 8rpx;
  margin-bottom: 32rpx;
  border-radius: 999rpx;
  background: #f2eae2;
}

.tabs__item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: var(--wte-text-weak);
}

.tabs__item--active {
  background: #ffffff;
  color: var(--wte-text);
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(180, 140, 105, 0.12);
}
