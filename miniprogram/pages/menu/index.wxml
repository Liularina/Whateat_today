<view class="page">
  <view class="tabs">
    <view
      class="tabs__item {{activeTab === 'today' ? 'tabs__item--active' : ''}}"
      data-tab="today"
      bindtap="onSwitchTab"
    >当前菜单</view>
    <view
      class="tabs__item {{activeTab === 'history' ? 'tabs__item--active' : ''}}"
      data-tab="history"
      bindtap="onSwitchTab"
    >历史菜单</view>
    <view
      class="tabs__item {{activeTab === 'calendar' ? 'tabs__item--active' : ''}}"
      data-tab="calendar"
      bindtap="onSwitchTab"
    >日历</view>
  </view>

  <!-- 家庭态未就绪：展示加载，不误判为「没有家庭」 -->
  <loading-state wx:if="{{!familyReady}}" text="正在准备..." />

  <!-- 无家庭（已确认） -->
  <empty-state
    wx:elif="{{!hasFamily}}"
    emoji="👨‍👩‍👧"
    title="还没有加入家庭"
    description="菜单是家庭共享的，先创建或加入一个家庭吧"
  />

  <!-- ============================== 当前菜单 ============================== -->
  <block wx:elif="{{activeTab === 'today'}}">
    <loading-state wx:if="{{todayLoading}}" text="加载中..." />

    <error-state
      wx:elif="{{todayError}}"
      title="加载失败"
      description="{{todayError}}"
      retryText="重试"
      bind:retry="loadToday"
    />

    <empty-state
      wx:elif="{{!todayMenu}}"
      icon="plate"
      title="还没有已确认的菜单"
      description="去首页发起推荐，确认后就会出现在这里"
      actionText="去首页看看"
      bind:action="onGoHome"
    />

    <block wx:else>
      <view class="menu-head">
        <view class="menu-head__title">{{todayMenu.mealTypeLabel}} · {{todayMenu.servings}} 人份</view>
        <view class="menu-head__meta">
          <view class="chip chip--muted">{{todayMenu.statusLabel}}</view>
          <text wx:if="{{todayMenu.dateLabel}}">{{todayMenu.dateLabel}}</text>
        </view>
      </view>

      <view class="dish-list">
        <view
          class="dish-card"
          wx:for="{{todayMenu.dishes}}"
          wx:key="recipeId"
          data-id="{{item.recipeId}}"
          data-name="{{item.name}}"
          bindtap="onOpenRecipe"
          hover-class="dish-card--hover"
        >
          <view class="dish-card__name">{{item.name}}</view>
          <view class="dish-card__meta">
            <view class="chip chip--muted" wx:if="{{item.category}}">{{item.category}}</view>
            <text wx:if="{{item.cookTime}}">{{item.cookTime}}</text>
          </view>
        </view>
      </view>

      <view class="actions">
        <view
          class="wte-btn wte-btn--primary wte-btn--block"
          data-id="{{todayMenu._id}}"
          bindtap="onOpenMenu"
        >查看菜单详情</view>
      </view>
    </block>
  </block>

  <!-- ============================== 历史菜单 ============================== -->
  <block wx:elif="{{activeTab === 'history'}}">
    <loading-state wx:if="{{historyLoading && historyMenus.length === 0}}" text="加载中..." />

    <error-state
      wx:elif="{{historyError && historyMenus.length === 0}}"
      title="加载失败"
      description="{{historyError}}"
      retryText="重试"
      bind:retry="onRetryHistory"
    />

    <empty-state
      wx:elif="{{historyMenus.length === 0}}"
      emoji="🗂️"
      title="还没有历史菜单"
      description="确认过的菜单会保存在这里，方便随时回看做法"
    />

    <view class="history-list" wx:else>
      <view
        class="history-card"
        wx:for="{{historyMenus}}"
        wx:key="menuId"
        data-id="{{item.menuId}}"
        bindtap="onOpenMenu"
        hover-class="history-card--hover"
      >
        <view class="history-card__header">
          <view class="history-card__title">{{item.mealTypeLabel}} · {{item.servings}} 人份</view>
          <view class="history-card__date">{{item.dateLabel}}</view>
        </view>
        <view class="history-card__dishes">{{item.dishSummary || '暂无菜品'}}</view>
        <view class="history-card__meta">
          <view class="chip chip--muted">{{item.statusLabel}}</view>
          <text>{{item.dishCount}} 道菜</text>
          <text wx:if="{{item.kcalLabel}}" class="history-card__kcal">{{item.kcalLabel}}</text>
        </view>
      </view>

      <view class="load-more" wx:if="{{historyLoading}}">加载中...</view>
      <view class="load-more" wx:elif="{{!historyHasMore}}">没有更多了</view>
    </view>
  </block>

  <!-- ================================================================ -->
  <!--                           日  历                                  -->
  <!-- ================================================================ -->
  <block wx:elif="{{activeTab === 'calendar'}}">
    <!-- 导航栏 -->
    <view class="cal-nav">
      <view class="cal-nav__left" bindtap="onPrevMonth">
        <text class="cal-nav__arrow">◀</text>
      </view>
      <view class="cal-nav__center">{{calendarYear}} 年 {{calendarMonth}} 月</view>
      <view class="cal-nav__right" bindtap="onNextMonth">
        <text class="cal-nav__arrow">▶</text>
      </view>
    </view>

    <!-- 模式切换 -->
    <view class="cal-modes">
      <view
        class="cal-modes__item {{calendarMode === 'month' ? 'cal-modes__item--active' : ''}}"
        data-mode="month"
        bindtap="onCalendarMode"
      >月</view>
      <view
        class="cal-modes__item {{calendarMode === 'week' ? 'cal-modes__item--active' : ''}}"
        data-mode="week"
        bindtap="onCalendarMode"
      >周</view>
    </view>

    <loading-state wx:if="{{calendarLoading}}" text="加载中..." />

    <!-- ===== 月视图 ===== -->
    <block wx:elif="{{calendarMode === 'month' && !calendarLoading}}">
      <view class="cal weekdays">
        <view class="cal__weekday" wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this">{{item}}</view>
      </view>
      <view class="cal month-grid">
        <view
          class="cal-cell {{item.isCurrentMonth ? '' : 'cal-cell--dim'}} {{item.isToday ? 'cal-cell--today' : ''}} {{item.hasMenu ? 'cal-cell--has-menu' : ''}}"
          wx:for="{{calendarDays}}"
          wx:key="date"
          data-date="{{item.date}}"
          bindtap="onDayTap"
        >
          <view class="cal-cell__day">{{item.day}}</view>
          <view class="cal-cell__dots" wx:if="{{item.hasMenu}}">
            <view
              class="cal-cell__dot {{menu.nutritionStatus === 'partial' ? 'cal-cell__dot--warn' : ''}}"
              wx:for="{{item.menus}}"
              wx:for-item="menu"
              wx:key="_id"
            />
          </view>
        </view>
      </view>

      <empty-state
        wx:if="{{calendarDays.length === 0}}"
        emoji="🗓️"
        title="本月暂无菜单"
      />

      <!-- 月统计 -->
      <view class="cal-stats" wx:if="{{monthStats && calendarMode === 'month'}}">
        <view class="cal-stats__title">本月统计（{{monthStats.daysWithMenu}} 天有菜单）</view>
        <view class="cal-stats__row">
          <view class="cal-stats__item">
            <view class="cal-stats__num">{{monthStats.totalCalories}}</view>
            <view class="cal-stats__label">总热量 kcal</view>
          </view>
          <view class="cal-stats__item">
            <view class="cal-stats__num">{{monthStats.avgCalories}}</view>
            <view class="cal-stats__label">日均 kcal</view>
          </view>
          <view class="cal-stats__item" wx:if="{{monthStats.totalProtein > 0}}">
            <view class="cal-stats__num">{{monthStats.totalProtein}} g</view>
            <view class="cal-stats__label">蛋白质</view>
          </view>
          <view class="cal-stats__item" wx:if="{{monthStats.totalFat > 0}}">
            <view class="cal-stats__num">{{monthStats.totalFat}} g</view>
            <view class="cal-stats__label">脂肪</view>
          </view>
        </view>
        <view class="cal-stats__warn" wx:if="{{monthStats.isPartial}}">部分菜单营养数据不完整</view>
      </view>
    </block>

    <!-- ===== 周视图 ===== -->
    <block wx:elif="{{calendarMode === 'week' && !calendarLoading}}">
      <view class="week-strip">
        <view
          class="week-day {{item.isToday ? 'week-day--today' : ''}}"
          wx:for="{{weekBars}}"
          wx:key="date"
          data-date="{{item.date}}"
          bindtap="onDayTap"
        >
          <view class="week-day__name">{{item.dayLabel}}</view>
          <view class="week-day__num">{{item.dayNum}}</view>
          <view class="week-day__kcal" wx:if="{{item.kcalLabel}}">{{item.kcalLabel}}</view>
          <view class="week-day__dot" wx:if="{{item.menuCount > 0}}">
            <text>{{item.menuCount}}</text>
          </view>
          <view class="week-day__empty" wx:else>
            <text>—</text>
          </view>
        </view>
      </view>

      <!-- 周统计 -->
      <view class="cal-stats" wx:if="{{weekStats}}">
        <view class="cal-stats__title">本周统计（{{weekStats.daysWithMenu}} 天有菜单）</view>
        <view class="cal-stats__row">
          <view class="cal-stats__item">
            <view class="cal-stats__num">{{weekStats.totalCalories}}</view>
            <view class="cal-stats__label">总热量 kcal</view>
          </view>
          <view class="cal-stats__item">
            <view class="cal-stats__num">{{weekStats.avgCalories}}</view>
            <view class="cal-stats__label">日均 kcal</view>
          </view>
          <view class="cal-stats__item" wx:if="{{weekStats.totalProtein > 0}}">
            <view class="cal-stats__num">{{weekStats.totalProtein}} g</view>
            <view class="cal-stats__label">蛋白质</view>
          </view>
          <view class="cal-stats__item" wx:if="{{weekStats.totalFat > 0}}">
            <view class="cal-stats__num">{{weekStats.totalFat}} g</view>
            <view class="cal-stats__label">脂肪</view>
          </view>
        </view>
        <view class="cal-stats__warn" wx:if="{{weekStats.isPartial}}">部分菜单营养数据不完整</view>
      </view>
    </block>

    <!-- ===== 日视图弹层 ===== -->
    <view class="cal-day-mask" wx:if="{{selectedDate}}" bindtap="onCloseDay">
      <view class="cal-day-panel" catchtap="">

        <!-- 日统计 -->
        <view class="cal-day-stats" wx:if="{{selectedDayStats}}">
          <view class="cal-day-stats__total">{{selectedDayStats.totalCalories}} kcal</view>
          <view class="cal-day-stats__row">
            <text class="cal-day-stats__macro" wx:if="{{selectedDayStats.totalProtein > 0}}">蛋白质 {{selectedDayStats.totalProtein}}g</text>
            <text class="cal-day-stats__macro" wx:if="{{selectedDayStats.totalFat > 0}}">脂肪 {{selectedDayStats.totalFat}}g</text>
            <text class="cal-day-stats__macro" wx:if="{{selectedDayStats.totalCarbs > 0}}">碳水 {{selectedDayStats.totalCarbs}}g</text>
          </view>
          <text class="cal-day-stats__warn" wx:if="{{selectedDayStats.isPartial}}">部分数据缺失</text>
        </view>

        <view class="cal-day-panel__header">
          <view class="cal-day-panel__date">{{selectedDateLabel}}</view>
          <view class="cal-day-panel__close" bindtap="onCloseDay">✕</view>
        </view>

        <empty-state
          wx:if="{{selectedDayMenus.length === 0}}"
          icon="plate"
          title="当天没有菜单"
          description="试试其他日期"
        />

        <view class="cal-day-list" wx:else>
          <view
            class="cal-day-item"
            wx:for="{{selectedDayMenus}}"
            wx:key="menuId"
            data-id="{{item.menuId}}"
            bindtap="onOpenMenu"
            hover-class="cal-day-item--hover"
          >
            <view class="cal-day-item__head">
              <view class="cal-day-item__type">{{item.mealTypeLabel}}</view>
              <view class="cal-day-item__count">{{item.dishCount}} 道菜</view>
            </view>
            <view class="cal-day-item__kcal" wx:if="{{item.kcalLabel}}">{{item.kcalLabel}}</view>
            <view class="cal-day-item__status" wx:elif="{{item.nutritionStatus === 'partial'}}">部分数据缺失</view>
            <view class="cal-day-item__status" wx:else>暂无热量数据</view>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>