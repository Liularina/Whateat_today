<view class="page page--with-footer">
  <view class="page-header">
    <view class="page-header__title">家庭点菜</view>
    <view class="page-header__subtitle">发起一次点菜，让家人一起决定今晚吃什么</view>
  </view>

  <empty-state
    emoji="📣"
    title="还没有进行中的点菜"
