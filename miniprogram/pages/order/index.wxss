/* 点单列表（Phase 9+10+11） */

/* Phase 11：状态筛选 */
.filter-bar {
  display: flex;
  padding: 8rpx;
  margin-bottom: 24rpx;
  border-radius: 999rpx;
  background: #f2eae2;
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--wte-text-weak);
}

.filter-item--active {
  background: #ffffff;
  color: var(--wte-text);
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(180, 140, 105, 0.12);
}

.order-list {
  margin-top: 20rpx;
}

.order-card {
  background: var(--wte-card);
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
}

.order-card + .order-card {
  margin-top: 16rpx;
}

.order-card--hover {
  background: #fff3e8;
}

.order-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-card__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--wte-text);
}

.order-card__status {
  font-size: 24rpx;
  color: var(--wte-text-weak);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #f0ece8;
}

.order-card__status--open {
  background: #fff3e8;
  color: #ff7a45;
}

.order-card__meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--wte-text-weak);
  display: flex;
  gap: 20rpx;
}

.order-card__footer {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--wte-text-weak);
  display: flex;
  gap: 20rpx;
}

.load-more {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: var(--wte-text-weak);
}