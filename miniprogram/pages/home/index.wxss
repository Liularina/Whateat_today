.hero {
  display: flex;
  align-items: center;
  margin-top: 40rpx;
  padding: 40rpx 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ff9a6b, #ff7a45);
  box-shadow: 0 16rpx 36rpx rgba(255, 122, 69, 0.28);
}

.hero--hover {
  opacity: 0.9;
}

.hero__emoji {
  font-size: 64rpx;
  margin-right: 24rpx;
}

.hero__text {
  flex: 1;
}

.hero__title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.hero__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
}

.hero__arrow {
  font-size: 48rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1;
}

.quick-actions {
  display: flex;
  margin-top: 28rpx;
  gap: 20rpx;
}

.quick-actions__item {
  flex: 1;
  padding: 28rpx 0;
  border-radius: 24rpx;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(180, 140, 105, 0.08);
}

.quick-actions__item--hover {
  background: #fff7f1;
}

.quick-actions__emoji {
  font-size: 44rpx;
}

.quick-actions__label {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--wte-text);
}

/* 登录失败时的重试入口 */
.login-retry {
  display: inline-block;
  margin-top: 20rpx;
  padding: 14rpx 44rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #ffffff;
  background: #ff7a45;
}

.login-retry--hover {
  opacity: 0.85;
}

/* 已登录但服务端校验失败（例如网络异常）时的提示 */
.login-warning {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #d97706;
}

/* ---------- 家庭卡片（已加入家庭） ---------- */
.family-card {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 32rpx rgba(180, 140, 105, 0.08);
}

.family-card--hover {
  background: #fff7f1;
}

.family-card__emoji {
  font-size: 52rpx;
  margin-right: 24rpx;
}

.family-card__body {
  flex: 1;
  min-width: 0;
}

.family-card__name {
  font-size: 34rpx;
  font-weight: 700;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.family-card__meta {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: var(--wte-text-weak);
}

.family-card__arrow {
  font-size: 44rpx;
  color: #c8b8a8;
  line-height: 1;
}

/* ---------- 无家庭引导（不强制跳转） ---------- */
.family-guide {
  margin-top: 32rpx;
  padding: 36rpx 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 32rpx rgba(180, 140, 105, 0.08);
}

.family-guide__title {
  font-size: 34rpx;
  font-weight: 700;
}

.family-guide__desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--wte-text-weak);
}

.family-guide__actions {
  display: flex;
  margin-top: 28rpx;
}

.family-guide__actions .wte-btn {
  flex: 1;
}

.family-guide__actions .wte-btn + .wte-btn {
  margin-left: 20rpx;
}

