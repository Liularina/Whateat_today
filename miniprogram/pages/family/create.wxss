.field__label {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.field__input {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #f7f1ea;
  font-size: 30rpx;
}

.field__placeholder {
  color: #b3a79b;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.chips .chip {
  margin: 0 16rpx 16rpx 0;
}

/* ---------- 自定义标签输入 ---------- */
.custom-row {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.custom-row__input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #f7f1ea;
  font-size: 28rpx;
}

.custom-row__btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 0 32rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 16rpx;
  background: #fff1e9;
  color: #d95f2f;
  font-size: 28rpx;
  font-weight: 600;
}

.custom-row__btn:active {
  opacity: 0.8;
}

/* ---------- 错误提示 ---------- */
.form-error {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #fdecee;
  color: var(--td-error-color);
  font-size: 26rpx;
}

/* ---------- 提交中 ---------- */
.wte-btn--busy {
  opacity: 0.6;
}
