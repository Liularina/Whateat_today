.field__label {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.card__desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--wte-text-weak);
}

.code-input {
  height: 110rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  background: #f7f1ea;
  letter-spacing: 10rpx;
  font-size: 44rpx;
  font-weight: 700;
  text-align: center;
}

.code-input__placeholder {
  color: #b3a79b;
  font-size: 30rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
}

.form-error {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #fdecee;
  color: var(--td-error-color);
  font-size: 26rpx;
}

.wte-btn--busy {
  opacity: 0.6;
}
