<view class="page">
  <view class="profile">
    <image class="profile__avatar" src="{{avatarDisplayUrl || avatarUrl}}" wx:if="{{avatarDisplayUrl || avatarUrl}}" mode="aspectFill" />
    <view class="profile__avatar profile__avatar--placeholder" wx:else>🙂</view>
    <view>
      <view class="profile__name">{{nickname}}</view>
      <view class="profile__family">用户状态：{{authStatus}}</view>
      <view class="profile__warning" wx:if="{{authError}}">{{authError}}</view>
    </view>
    <view class="profile__edit" wx:if="{{authStatus === '已登录'}}" bindtap="onGoProfileSetup">编辑</view>
  </view>

  <!-- 当前家庭 -->
  <view class="card">
    <block wx:if="{{isInFamily}}">
      <view class="card__title">当前家庭</view>
      <view class="family-name">{{familyName}}</view>
      <view class="card__desc">{{memberCount}} 位成员</view>
      <view class="wte-btn wte-btn--ghost wte-btn--block" bindtap="onGoFamily">家庭管理</view>
    </block>

    <block wx:elif="{{familyReady}}">
      <view class="card__title">暂无家庭</view>
      <view class="card__desc">创建一个家庭，和家人一起决定今晚吃什么。</view>
      <view class="wte-btn wte-btn--primary wte-btn--block" bindtap="onGoCreateFamily">创建家庭</view>
      <view class="wte-btn wte-btn--ghost wte-btn--block btn-gap" bindtap="onGoJoinFamily">加入家庭</view>
    </block>

    <block wx:else>
      <view class="card__desc">正在加载家庭信息…</view>
    </block>
  </view>

  <view class="family-error" wx:if="{{familyError}}">{{familyError}}</view>

  <!-- 阶段二：厨师等级与成长 -->
  <view class="card growth" wx:if="{{isInFamily && growth}}">
    <view class="growth__head">
      <view class="growth__level">{{growth.levelName}}</view>
      <view class="growth__points">{{growth.points}} 分</view>
    </view>
    <view class="card__desc">厨师等级按累计积分计算，完成本餐与获得好评都会加分。</view>
    <view class="growth__bar">
      <view class="growth__bar-fill" style="width: {{growthProgress}}%"></view>
    </view>
    <view class="growth__next">{{growthNextLabel}}</view>
    <view class="growth__last" wx:if="{{growthLastLabel}}">最近一次：{{growthLastLabel}}</view>
  </view>

  <view class="cells">
    <t-cell-group theme="card">
      <t-cell title="历史菜单" description="回看过去确认过的菜单与做法" arrow bind:click="onGoHistoryMenu" />
      <t-cell title="历史点单" description="查看进行中与已关闭的家庭点单" arrow bind:click="onGoHistoryOrder" />
      <t-cell title="我的菜谱" description="查看全家已保存的详细做法" arrow bind:click="onGoCookbook" />
    </t-cell-group>
  </view>

  <view class="cells">
    <t-cell-group theme="card">
      <t-cell title="模型 API 设置" arrow bind:click="onGoAiSettings" />
      <t-cell title="关于" description="{{appName}} V{{version}}（{{envName}}）" />
    </t-cell-group>
  </view>

  <view class="tips">热量和营养数据为系统估算值，仅供饮食参考。</view>
</view>
