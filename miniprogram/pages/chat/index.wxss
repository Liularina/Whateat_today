.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #fbf7f2;
}

/* ---- 消息列表 ---- */
.chat-list {
  flex: 1;
  padding: 20rpx 24rpx;
  overflow-y: auto;
}

.chat-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
}

/* 做饭的小姑娘形象（内联 SVG，避免使用 🤖 机器人图标） */
.chat-robot-icon {
  width: 132rpx;
  height: 132rpx;
  margin-bottom: 24rpx;
  border-radius: 50%;
  background-image: url("data:image/svg+xml;base64,");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.chat-welcome {
  max-width: 480rpx;
  font-size: 28rpx;
  color: #6b5e4b;
  line-height: 1.6;
  text-align: center;
  margin-bottom: 32rpx;
}

.chat-quick-asks {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
  max-width: 560rpx;
}

.chat-quick-ask {
  padding: 10rpx 20rpx;
  background: #fff;
  border: 1rpx solid #e8e0d4;
  border-radius: 100rpx;
  font-size: 26rpx;
  color: #6b5e4b;
}
.chat-quick-ask:active {
  background: #fff0e6;
  border-color: #ff7a45;
  color: #ff7a45;
}

/* ---- 消息气泡 ---- */
.chat-msg {
  display: flex;
  margin-bottom: 24rpx;
}
.chat-msg--user {
  justify-content: flex-end;
}
.chat-msg--bot {
  justify-content: flex-start;
}

.chat-msg__avatar {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  margin-right: 12rpx;
  border-radius: 50%;
  background-image: url("data:image/svg+xml;base64,");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.chat-msg__bubble {
  max-width: 70%;
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.chat-msg__bubble--user {
  background: #ff7a45;
  color: #fff;
}

.chat-msg__bubble--bot {
  background: #fff;
  color: #333;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 打字动画 */
.chat-msg__bubble--typing {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 28rpx;
}
.typing-dot {
  width: 12rpx;
  height: 12rpx;
  background: #ccc;
  border-radius: 50%;
  animation: bounce 0.6s infinite alternate;
}
.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes bounce {
  from { transform: translateY(0); }
  to { transform: translateY(-8rpx); }
}

/* ---- 错误 ---- */
.chat-error {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 16rpx;
  font-size: 26rpx;
  color: #c53030;
}
.chat-retry {
  padding: 4rpx 16rpx;
  border: 1rpx solid #c53030;
  border-radius: 8rpx;
  color: #c53030;
  font-size: 24rpx;
}
.chat-retry:active {
  background: #fef2f2;
}

/* ---- 输入栏 ---- */
.chat-input-bar {
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0ebe0;
}

.chat-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  background: #f7f3eb;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.chat-send-btn {
  flex-shrink: 0;
  padding: 14rpx 32rpx;
  background: #e8e0d4;
  color: #9a8c7d;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.chat-send-btn--active {
  background: #ff7a45;
  color: #fff;
}