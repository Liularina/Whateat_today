<view class="page page--with-footer">
  <view class="page-header">
    <view class="page-header__title">今天吃什么</view>
    <view class="page-header__subtitle">按人数和口味，让 AI 从菜谱库中为你推荐</view>
  </view>

  <!-- API 未配置提示 -->
  <view class="config-banner" wx:if="{{!aiConfigured}}">
    <view class="config-banner__text">尚未配置模型 API，需先设置才能使用推荐功能</view>
    <view class="wte-btn wte-btn--ghost config-banner__btn" bindtap="onGoSettings">去设置</view>
  </view>

  <view class="card">
    <view class="field">
      <view class="field__label">用餐人数</view>
      <view class="chips">
        <view
          wx:for="{{peopleOptions}}"
          wx:key="*this"
          class="chip {{item === peopleCount ? 'chip--active' : ''}}"
          data-value="{{item}}"
          bindtap="onSelectPeople"
        >{{item >= 5 ? '5+' : item}}</view>
      </view>
    </view>

    <view class="field">
      <view class="field__label">餐次</view>
      <view class="chips">
        <view
          wx:for="{{mealTypeOptions}}"
          wx:key="value"
          class="chip {{item.value === mealType ? 'chip--active' : ''}}"
          data-value="{{item.value}}"
          bindtap="onSelectMealType"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="field">
      <view class="field__label">口味</view>
      <view class="chips">
        <view
          wx:for="{{tasteOptions}}"
          wx:key="label"
          class="chip {{item.active ? 'chip--active' : ''}}"
          data-index="{{index}}"
          bindtap="onToggleTaste"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="field">
      <view class="field__label">最大烹饪时间</view>
      <view class="chips">
        <view
          wx:for="{{cookTimeOptions}}"
          wx:key="*this"
          class="chip {{item === maxCookTime ? 'chip--active' : ''}}"
          data-value="{{item}}"
          bindtap="onSelectCookTime"
        >{{item}} 分钟</view>
      </view>
    </view>

    <view class="field field--row">
      <view>
        <view class="field__label">优先清空库存</view>
        <view class="text-weak text-sm">尽量先用掉快过期或已有的食材</view>
      </view>
      <t-switch checked="{{clearInventoryFirst}}" bind:change="onToggleClearInventory" />
    </view>
  </view>

  <!-- API 设置快捷入口 -->
  <view class="settings-link" bindtap="onGoSettings" wx:if="{{aiConfigured}}">
    <text>模型 API 设置 ›</text>
  </view>

  <view class="footer-bar">
    <view class="wte-btn wte-btn--primary wte-btn--block" wx:if="{{!recommending}}" bindtap="onStartRecommend">
      开始推荐
    </view>
    <view class="wte-btn wte-btn--primary wte-btn--block wte-btn--loading" wx:else>
      正在让 AI 选菜...
    </view>
  </view>
</view>
