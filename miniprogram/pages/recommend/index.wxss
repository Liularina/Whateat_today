.field {
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--wte-line);
}

.field:last-child {
  border-bottom: none;
}

.field--row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field__label {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.field--row .field__label {
  margin-bottom: 4rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* Phase 7 新增 */

.config-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  background: #fff3e8;
  border-radius: 16rpx;
  margin-bottom: 8rpx;
}

.config-banner__text {
  font-size: 26rpx;
  color: #d95f2f;
  flex: 1;
}

.config-banner__btn {
  flex: none;
  margin-left: 20rpx;
  font-size: 24rpx;
}

.settings-link {
  text-align: right;
  padding: 12rpx 0 8rpx;
  font-size: 26rpx;
  color: var(--wte-text-weak);
}
