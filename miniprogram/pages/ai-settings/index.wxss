/* ============================== AI 模式选择 ============================== */

.mode-card {
  margin-bottom: 8rpx;
}

.mode-card__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--wte-text);
  margin-bottom: 20rpx;
}

.mode-row {
  display: flex;
  gap: 20rpx;
}

.mode-pill {
  flex: 1;
  padding: 20rpx;
  border: 2rpx solid #e8e0d8;
  border-radius: 16rpx;
  text-align: center;
  position: relative;
}

.mode-pill--active {
  border-color: #ff7a45;
  background: #fff7ef;
}

.mode-pill__label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--wte-text);
}

.mode-pill__desc {
  font-size: 22rpx;
  color: var(--wte-text-weak);
  margin-top: 4rpx;
}

.mode-pill__badge {
  position: absolute;
  top: -8rpx;
  right: -4rpx;
  padding: 2rpx 12rpx;
  background: #ff7a45;
  color: #fff;
  font-size: 20rpx;
  border-radius: 20rpx;
}

.mode-pill__loading {
  text-align: center;
  font-size: 24rpx;
  color: var(--wte-text-weak);
  margin-top: 12rpx;
}

.mode-info {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: #faf6f0;
  border-radius: 12rpx;
}

.mode-info__row {
  font-size: 24rpx;
  color: var(--wte-text);
  line-height: 1.8;
}

.mode-info__hint {
  font-size: 22rpx;
  color: #d95f2f;
  margin-top: 8rpx;
}

/* 表单卡片内的区块头部 */
.card__section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card__section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--wte-text);
}

.card__section-toggle {
  font-size: 26rpx;
  color: #ff7a45;
}

/* ============================== 原有样式 ============================== */

.saved-banner {
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  background: #e8f5e9;
  color: #2e7d32;
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.field {
  margin-bottom: 28rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field__label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--wte-text);
  margin-bottom: 12rpx;
}

.field__label-extra {
  font-weight: 400;
  font-size: 24rpx;
  color: var(--wte-text-weak);
}

.field__hint {
  font-size: 24rpx;
  color: var(--wte-text-weak);
  margin-top: 8rpx;
}

.input {
  width: 100%;
  height: 84rpx;
  padding: 0 28rpx;
  background: #faf6f0;
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.masked-key {
  padding: 20rpx 28rpx;
  background: #faf6f0;
  border-radius: 16rpx;
}

.masked-key__text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--wte-text);
}

.masked-key__hint {
  font-size: 24rpx;
  color: var(--wte-text-weak);
  margin-top: 4rpx;
}

.actions {
  margin-top: 32rpx;
}

.test-result {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
}

.test-result--success {
  background: #e8f5e9;
  color: #2e7d32;
}

.test-result--error {
  background: #fff1e9;
  color: #d95f2f;
}

.tips {
  margin-top: 40rpx;
  padding: 28rpx;
  background: var(--wte-card);
  border-radius: 24rpx;
}

.tips__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--wte-text);
  margin-bottom: 16rpx;
}

.tips__item {
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--wte-text-weak);
}

.btn-gap {
  margin-top: 20rpx;
}

.error-tip {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #fff1e9;
  color: #d95f2f;
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

/* 二次确认弹窗 */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.overlay__card {
  width: 580rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
}

.overlay__title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--wte-text);
}

.overlay__desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--wte-text-weak);
  line-height: 1.5;
}

.overlay__actions {
  display: flex;
  margin-top: 32rpx;
  gap: 20rpx;
}

.overlay__actions .wte-btn {
  flex: 1;
}