/* 我的菜谱列表（Phase D） */

.error-tip {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #fff1e9;
  color: #d95f2f;
  font-size: 26rpx;
}

.dish-list {
  margin-top: 24rpx;
}

.dish-card {
  background: var(--wte-card);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(180, 140, 105, 0.08);
}

.dish-card + .dish-card {
  margin-top: 20rpx;
}

.dish-card--hover {
  background: #fffaf6;
}

.dish-card__name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--wte-text);
}

.dish-card__meta {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.dish-card__cat {
  flex: none;
  padding: 6rpx 18rpx;
  font-size: 24rpx;
}

.dish-card__meta-text {
  margin-left: 14rpx;
  font-size: 24rpx;
  color: var(--wte-text-weak);
}

.dish-card__version {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #c07a52;
}
