.menu-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(180, 140, 105, 0.08);
}

.menu-card--hover {
  background: #fffaf6;
}

.menu-card__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.menu-card__title {
  font-size: 34rpx;
  font-weight: 700;
}

.menu-card__date {
  font-size: 24rpx;
  color: var(--wte-text-weak);
}

.menu-card__dishes {
  margin-top: 20rpx;
}

.menu-card__dish {
  font-size: 28rpx;
  line-height: 1.9;
}

.menu-card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--wte-line);
}

.menu-card__kcal {
  font-size: 26rpx;
  color: #d95f2f;
  font-weight: 600;
}

.menu-card__link {
  font-size: 26rpx;
  color: var(--wte-text-weak);
}
