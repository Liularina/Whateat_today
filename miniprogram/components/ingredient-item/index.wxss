.ingredient {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--wte-line);
}

.ingredient:last-child {
  border-bottom: none;
}

/* 已过期整体降低存在感，但仍可操作 */
.ingredient--expired .ingredient__name,
.ingredient--expired .ingredient__qty {
  color: #b3a79b;
}

.ingredient__main {
  flex: 1;
  min-width: 0;
}

.ingredient__name {
  font-size: 30rpx;
  font-weight: 600;
}

.ingredient__alias {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--wte-text-weak);
}

.ingredient__meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--wte-text-weak);
}

.ingredient__meta text + text {
  margin-left: 12rpx;
}

.ingredient__tag {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: #f2eae2;
}

.ingredient__expire {
  color: var(--wte-text-weak);
}

.ingredient__shelf--warning {
  color: #d98418;
  font-weight: 600;
}

.ingredient__shelf--expired {
  color: #e34d59;
  font-weight: 600;
}

.ingredient__qty {
  margin: 0 20rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* 快捷操作行：换到第二行，占满整宽 */
.ingredient__ops {
  width: 100%;
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.ingredient__op {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #f7f2ec;
  font-size: 24rpx;
  color: #9a8c7d;
}
