<view class="ingredient {{item.isExpired ? 'ingredient--expired' : ''}}">
  <view class="ingredient__main" bindtap="onEdit">
    <view class="ingredient__name">
      {{item.standardName}}
      <text class="ingredient__alias" wx:if="{{item.aliasText}}">{{item.aliasText}}</text>
      <text class="ingredient__calorie" wx:if="{{item.calorieText}}">{{item.calorieText}}</text>
    </view>
    <view class="ingredient__meta">
      <text class="ingredient__tag" wx:if="{{categoryLabel}}">{{categoryLabel}}</text>
      <text class="ingredient__shelf ingredient__shelf--expired" wx:if="{{item.isExpired}}">⚠ {{item.shelfLabel}}</text>
      <text class="ingredient__shelf ingredient__shelf--warning" wx:elif="{{item.isWarning}}">⏰ {{item.shelfLabel}}</text>
      <text class="ingredient__expire" wx:elif="{{item.expireDate}}">{{item.expireDate}} 到期</text>
      <text class="ingredient__remark" wx:if="{{item.remark}}">{{item.remark}}</text>
    </view>
  </view>

  <view class="ingredient__qty">{{item.quantityText}}</view>

  <view class="ingredient__ops">
    <view class="ingredient__op" catchtap="onConsume">消耗</view>
    <view class="ingredient__op" catchtap="onRestock">补货</view>
    <view class="ingredient__op" catchtap="onRecipes">做法</view>
  </view>
</view>
