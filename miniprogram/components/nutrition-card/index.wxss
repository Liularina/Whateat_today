.nutrition {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(180, 140, 105, 0.08);
}

.nutrition__title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.nutrition__grid {
  display: flex;
  justify-content: space-between;
}

.nutrition__item {
  flex: 1;
  text-align: center;
}

.nutrition__value {
  font-size: 30rpx;
  font-weight: 700;
  color: #d95f2f;
}

.nutrition__label {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--wte-text-weak);
}

.nutrition__empty {
  padding: 24rpx 0;
  text-align: center;
  color: var(--wte-text-weak);
  font-size: 26rpx;
}

.nutrition__total {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--wte-line);
  font-size: 24rpx;
  color: var(--wte-text-weak);
  line-height: 1.7;
}

.nutrition__disclaimer {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #b3a79b;
}
