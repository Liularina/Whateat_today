.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 48rpx;
}

.loading-state__spinner {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 6rpx solid #ffe0cf;
  border-top-color: #ff7a45;
  animation: wte-spin 0.8s linear infinite;
}

.loading-state__text {
  margin-top: 28rpx;
  font-size: 28rpx;
  color: var(--wte-text-weak);
  text-align: center;
}

@keyframes wte-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
