.recipe-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(180, 140, 105, 0.08);
}

.recipe-card--locked {
  border: 2rpx solid #ffd8c6;
}

.recipe-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.recipe-card__name {
  font-size: 34rpx;
  font-weight: 700;
}

.recipe-card__lock {
  font-size: 24rpx;
  color: #d95f2f;
}

.recipe-card__desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--wte-text-weak);
}

.recipe-card__meta {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: var(--wte-text-weak);
}

.recipe-card__meta text + text {
  margin-left: 8rpx;
}

.recipe-card__reason {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #d95f2f;
}

.recipe-card__missing {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #b3a79b;
}

.recipe-card__actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--wte-line);
}

.recipe-card__action {
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  background: #f7f1ea;
  color: var(--wte-text);
}

.recipe-card__action--active {
  background: #fff1e9;
  color: #d95f2f;
}
