{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "removeComments": false,
    "sourceMap": true,
    "experimentalDecorators": true,
    "typeRoots": ["./node_modules"],
    "types": ["miniprogram-api-typings"],
    "paths": {
      "@/*": ["./miniprogram/*"]
    }
  },
  "include": ["./miniprogram/**/*.ts"],
  "exclude": ["node_modules", "miniprogram/miniprogram_npm", "cloudfunctions"]
}
